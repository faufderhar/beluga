{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@beluga/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "touch-reveal.ts",
    "../../src/net/hyperdht.d.ts"
  ]
}